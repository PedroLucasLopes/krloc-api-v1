# Copie para .env.docker (container) ou .env (npm run start:dev).
# Gere segredos com: openssl rand -hex 32
#
# Regra geral: o que ja esta persistido no banco do SSO nao se repete aqui.
# As duas excecoes estao marcadas abaixo, e cada uma tem uma razao tecnica,
# nao uma conveniencia.

# ------------------------------- Banco --------------------------------- #
# Banco de dominio do krloc. O SSO nao o alcanca, e nem deve.
DATABASE_URL=postgresql://postgres:senha@host.docker.internal:5432/krloc?schema=public

# -------------------------------- SSO ---------------------------------- #
# Identidade PUBLICA do SSO: a mesma string da claim `iss` dos tokens.
SSO_ISSUER=http://localhost:8080/sso
# Endereco do SSO visto de DENTRO do container. Serve para a troca de code e
# a busca do JWKS, que sao chamadas de servidor para servidor. O SSO roda no
# compose do proprio repositorio e publica a 8080 na maquina, entao daqui ele
# e alcancado pelo host. Em `npm run start:dev`, fora do container, use
# http://localhost:8080/sso.
SSO_INTERNAL_URL=http://host.docker.internal:8080/sso

# ---------------------------- Identidade -------------------------------- #
# Base PUBLICA desta aplicacao, do ponto de vista do NAVEGADOR, com prefixo.
# O callback registrado no SSO e ${APP_BASE_URL}/auth/callback.
#
# Em desenvolvimento o front do KRLoc roda em :5174 e proxia /api para o
# container em :3000. Quem o navegador enxerga e o front, entao e o endereco
# DELE que vai aqui. Front e API na mesma origem: sem CORS, e o SameSite=Strict
# dos cookies continua valendo sem ressalva.
#
# Sem front, aponte direto para o container: http://localhost:3000/api
APP_BASE_URL=http://localhost:5174/api

# Destino do login quando nao ha returnTo. `/` e a home do front.
APP_POST_LOGIN_REDIRECT=/

# Tela PUBLICA do front para onde o callback devolve quem nao conseguiu entrar,
# com ?auth_error=<codigo>: conta sem papel no projeto KRLoc (access_denied),
# pedido de login expirado, SSO fora do ar. Sem ela, o callback responde JSON, e
# e esse JSON que a pessoa ve. Tem de ser tela fora do guard de sessao do front,
# senao a recusa vira laco de login. Sem front, deixe vazia.
APP_LOGIN_ERROR_REDIRECT=/sign-in-error

# Vida do cookie de sessao, em segundos. Tem de acompanhar REFRESH_TOKEN_TTL
# e AUTH_SESSION_TTL do SSO: o menor dos tres e quem decide quando a pessoa
# volta a ver a tela de login. 90 dias.
APP_SESSION_MAX_AGE=7776000

# EXCECAO 1. Identificador publico do cliente (RFC 6749 secao 2.2). Existe
# como Project.clientId no banco do SSO, mas precisa ser config local: e com
# ele que o krloc se identifica ANTES de poder perguntar qualquer coisa ao
# SSO. Buscar do SSO exigiria ja saber qual registro buscar.
APP_CLIENT_ID=

# EXCECAO 2. Metade PRIVADA do par de private_key_jwt (RFC 7523). O banco do
# SSO guarda so a metade publica, em ClientKey. Se guardasse esta, um dump do
# banco permitiria personificar toda aplicacao registrada. Gerada pelo SSO em
# POST /sso/clientkey/generate, devolvida uma unica vez, entregue em mao.
APP_PRIVATE_KEY_BASE64=

# ------------------------------ Cookies -------------------------------- #
# Nome dos cookies desta aplicacao: app_session vira krloc_session.
# Precisa ser UNICO entre aplicacoes que dividam host. Cookie nao e isolado
# por porta (RFC 6265 secao 8.5), entao em desenvolvimento todas as
# aplicacoes em localhost dividem o mesmo pote: sem prefixo proprio, a
# segunda a logar sobrescreve a sessao da primeira.
# Sem valor aqui, a biblioteca deriva oito digitos do APP_CLIENT_ID.
APP_COOKIE_PREFIX=krloc

# Cifra os cookies do krloc. E diferente da COOKIE_SECRET do SSO de
# proposito: cada dominio cifra o proprio estado.
COOKIE_SECRET=
COOKIE_SECURE=false
# `strict` e o padrao, como pede a RFC 10017 secao 6.1.3.2. SameSite compara
# SITE, nao origem: porta e subdominio nao contam, entao localhost:8080 e
# localhost:3000 sao o mesmo site, e sso.exemplo.com e app.exemplo.com tambem.
# So baixe para `lax` se o SSO viver em outro dominio registravel.
COOKIE_SAMESITE=strict

# ------------------------------ Externos ------------------------------- #
ZIPCODE_API_URL=https://viacep.com.br/ws

# ------------------------------- Rede ---------------------------------- #
# Quantos saltos de proxy confiar no `X-Forwarded-For`. Sem isto, o IP de quem
# pediu e o do proxy, e o limite de requisicoes conta todo mundo junto. Ligue
# SO quando houver proxy na frente (nginx do front, load balancer): com acesso
# direto, qualquer um escolheria o proprio IP no cabecalho.
# TRUST_PROXY=1
