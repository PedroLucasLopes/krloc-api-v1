# Configuracao do teste de integracao (`npm run test:sso`). Copie para
# .env.test, que e ignorado pelo git.
#
# Esta aplicacao e independente: repositorio, infraestrutura e ciclo de vida
# proprios. O teste NAO le arquivo de outro projeto. O que ele precisa do SSO
# vem daqui, preenchido uma vez por quem opera o ambiente.

# Onde o backend DESTA aplicacao de fato atende, sem passar pelo front.
# Em desenvolvimento o navegador vai ao front em :5174, que proxia /api para
# ca; o teste faz o papel do proxy e fala direto com o container.
APP_TEST_BASE_URL=http://localhost:3000/api

# Opcional. Uma segunda instancia desta aplicacao, igual a primeira, mas sem
# caminho ate o SSO: SSO_INTERNAL_URL numa porta fechada. E nela que o teste
# confere que SSO fora do ar nao derruba a sessao. Sem esta linha, a secao e
# pulada e o resumo avisa. Em container, ao lado da stack de pe:
#   docker compose run --rm --no-deps -p 3011:3000 -e SSO_INTERNAL_URL=http://127.0.0.1:1/sso krloc
# APP_TEST_SSO_DOWN_BASE_URL=http://localhost:3011/api

# ---------------------- credenciais do SSO alvo ------------------------- #
# Substituem o login federado, que nenhum teste automatizado consegue fazer.
# Sao credenciais de OPERADOR do SSO contra o qual este teste roda, e so
# existem em ambiente de desenvolvimento.

# Conexao com o banco do SSO. O teste cria a sessao e confere revogacao.
SSO_TEST_DATABASE_URL=postgresql://postgres:senha@127.0.0.1:5432/sso?schema=public

# COOKIE_SECRET do SSO, em hex. E com ela que o cookie de sessao e selado.
# Diferente da COOKIE_SECRET desta aplicacao, de proposito.
SSO_TEST_COOKIE_SECRET=
